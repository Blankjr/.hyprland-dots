#!/usr/bin/env bash

# Focus an editor's existing Hyprland group before launching another window.
# The app's `group = set always` window rule will then add the new window to it.

set -u

if (( $# < 2 )); then
    echo "usage: grouped-editor-launch CLASS_REGEX COMMAND [ARG ...]" >&2
    exit 2
fi

class_regex=$1
shift

if command -v hyprctl >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; then
    clients_json=$(hyprctl clients -j 2>/dev/null || true)
    target_address=$(
        jq -r --arg class_regex "$class_regex" '
            [
                .[]
                | select(.mapped and (.class | test($class_regex)))
            ]
            | sort_by(.focusHistoryID)
            | .[0].address // empty
        ' <<< "$clients_json" 2>/dev/null
    )

    if [[ -n $target_address ]]; then
        # focuswindow also switches to the window's existing regular workspace.
        hyprctl dispatch "hl.dsp.focus({ window = \"address:$target_address\" })" >/dev/null 2>&1 || true
        # App groups must accept the window even if they were locked manually.
        hyprctl dispatch 'hl.dsp.group.lock_active({ action = "disable" })' >/dev/null 2>&1 || true
    else
        # Do not let an app's first window join a different app's active group.
        active_group_size=$(
            hyprctl activewindow -j 2>/dev/null \
                | jq -r '.grouped | length' 2>/dev/null
        )
        if [[ ${active_group_size:-0} -gt 0 ]]; then
            hyprctl dispatch 'hl.dsp.group.lock_active({ action = "enable" })' >/dev/null 2>&1 || true
        fi
    fi
fi

exec "$@"
